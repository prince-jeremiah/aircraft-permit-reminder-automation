    {
      "parameters": {
        "sendTo": "={{ $('Get row(s) in sheet').item.json['Responsible Email'] }}",
        "subject": "=Aircraft Permit Expiry Reminder - {{$json[\"Registration\"]}}",
        "emailType": "text",
        "message": "=Dear Maintenance Team,\n\nThis is an automated reminder that the following permit will expire within the next 30 days.\n\nRegistration: {{$json[\"Registration\"]}}\nAircraft Type: {{$json[\"Aircraft Type\"]}}\nPermit Type: {{$json[\"Permit Type\"]}}\nExpiry Date: {{$json[\"Expiry Date\"]}}\n\nPlease arrange renewal before the expiry date.\n\nThank you.",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        -272,
        -432
      ],
      "id": "0bd4ca0a-cbe6-4ef1-9ccb-67badb3a7bab",
      "name": "Send a message",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const expiry = new Date($json[\"Expiry Date\"]);\nconst today = new Date();\n\nconst daysRemaining = Math.ceil(\n  (expiry - today) / (1000 * 60 * 60 * 24)\n);\n\nlet status = \"\";\n\nif (daysRemaining < 0) {\n  status = \"Expired\";\n} else if (daysRemaining <= 30) {\n  status = \"Due Soon\";\n} else {\n  status = \"Active\";\n}\n\n// Determine which reminder should be sent\nlet reminderType = \"\";\n\nif (daysRemaining === 30) {\n  reminderType = \"30 Day Reminder Sent\";\n} else if (daysRemaining === 14) {\n  reminderType = \"14 Day Reminder Sent\";\n} else if (daysRemaining === 7) {\n  reminderType = \"7 Day Reminder Sent\";\n} else if (daysRemaining === 1) {\n  reminderType = \"1 Day Reminder Sent\";\n}\n\n// Save calculated values\n$json.daysRemaining = daysRemaining;\n$json.status = status;\n$json.reminderType = reminderType;\n\n// Only send email on the reminder days\n$json.sendReminder = reminderType !== \"\";\n\nreturn $input.item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -832,
        -400
      ],
      "id": "164d699e-8fbb-48b1-b8b1-0d734861d1f9",
